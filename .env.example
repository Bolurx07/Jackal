# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon: Dashboard -> your project -> Connect -> copy the connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Anthropic Console -> API Keys
ANTHROPIC_API_KEY=

# Optional: model used for job scoring (default: claude-opus-5-5)
# JACKAL_MODEL=claude-sonnet-5-5

# Optional: Gmail inbox tracking (read-only). See README "Gmail setup".
# Recommended: Gmail API with read-only OAuth. Create a "Desktop app" OAuth client in
# Google Cloud Console, paste its ID and secret here, then run: npm run jackal:gmail-auth
GMAIL_PROVIDER=api
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Fallback only: IMAP with an app password (set GMAIL_PROVIDER=imap to use it).
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=
